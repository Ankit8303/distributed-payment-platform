{
  "uid": "ledger-integrity",
  "title": "Payment Ledger — Ledger Integrity",
  "tags": ["payment-ledger", "ledger", "financial"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "CRITICAL: Unbalanced Transactions (24h)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "expr": "increase(ledger_unbalanced_transaction_total[24h])", "legendFormat": "" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0 — OK",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "options": { "colorMode": "background", "textMode": "auto" }
    },
    {
      "id": 2,
      "title": "CRITICAL: Ledger Invariant Failures (24h)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [
        { "expr": "increase(ledger_invariant_failure_total[24h])", "legendFormat": "" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0 — OK",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "options": { "colorMode": "background" }
    },
    {
      "id": 3,
      "title": "Ledger Transaction Failure Rate",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(ledger_transaction_failure_total[5m])) / (sum(rate(ledger_transaction_posted_total[5m])) + 0.001) * 100",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 2 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Insufficient Funds Rate",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(ledger_balance_check_total{result=\"INSUFFICIENT\"}[5m]))",
          "legendFormat": ""
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 5,
      "title": "Ledger Transactions Posted by Type",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "sum(rate(ledger_transaction_posted_total[1m])) by (type)",
          "legendFormat": "{{ type }}"
        },
        {
          "expr": "sum(rate(ledger_transaction_failure_total[1m]))",
          "legendFormat": "Failures"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 6,
      "title": "Balance Checks — Sufficient vs Insufficient",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "targets": [
        {
          "expr": "sum(rate(ledger_balance_check_total{result=\"SUFFICIENT\"}[1m]))",
          "legendFormat": "Sufficient"
        },
        {
          "expr": "sum(rate(ledger_balance_check_total{result=\"INSUFFICIENT\"}[1m]))",
          "legendFormat": "Insufficient"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 7,
      "title": "Refund & Reversal Rates",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "targets": [
        { "expr": "sum(rate(refund_created_total[1m]))", "legendFormat": "Refunds Created" },
        { "expr": "sum(rate(refund_settled_total[1m]))", "legendFormat": "Refunds Settled" },
        { "expr": "sum(rate(refund_failed_total[1m]))", "legendFormat": "Refunds Failed" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    }
  ]
}
